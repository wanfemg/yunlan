# Default to demo data. Live mode uses the main database for site-admin CRUD.
APP_MODE=demo

# Machine/admin API token; the browser now signs in with the NewAPI owner
# username and password. Required in live mode; never put it into the browser.
ADMIN_TOKEN=
# auto: Secure on HTTPS (or a trusted loopback HTTPS reverse proxy).
# Set true for a production HTTPS reverse proxy. false is only for local HTTP.
SITEADMIN_COOKIE_SECURE=auto

# Main NewAPI database. Supported drivers: postgres, mysql.
MAIN_DB_DRIVER=postgres
MAIN_DB_DSN=

# Optional request-log database. Configure both values or leave both blank.
LOG_DB_DRIVER=
LOG_DB_DSN=

# Optional NewAPI management connection for write operations. Grant the data
# access required by the site-admin features (SELECT/INSERT/UPDATE/DELETE).
# Leave blank to use the main database connection for writes.
MANAGEMENT_DB_DRIVER=
MANAGEMENT_DB_DSN=

# NewAPI origin is required for owner username/password login in live mode.
# The administrator token/ID below are separate machine management settings.
NEWAPI_UPSTREAM=
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=

# Shared machine key for signed login/registration probe observations.
# Leave blank until the independent login-probe is configured.
PROBE_SHARED_SECRET=
# Run the independent login/registration gateway after configuring its upstream.
LOGIN_PROBE_ENABLED=false
PROBE_BIND_ADDRESS=127.0.0.1
PROBE_HOST_PORT=18081
PROBE_TRUSTED_PROXIES=

# Internal finance service, generated by install.sh / Start-Integrated.ps1.
# This is a machine credential, never an additional finance login.
FINANCE_PROXY_SECRET=

# Install-IPIntelligence.ps1 downloads local City/ASN and public VPN/Tor lists
# on Windows, without per-IP requests. The IP maintenance panel can update and
# hot-reload generations, and import optional ISP / Anonymous-IP MMDB files.
GEOIP_CITY_PATH=
GEOIP_ASN_PATH=
GEOIP_ISP_PATH=
GEOIP_ANONYMOUS_PATH=
# Empty selects DATA_DIR/ip-intelligence and its active generation.
IP_INTELLIGENCE_DIR=

# Only declare true after verifying lifetime API-call history coverage.
# This does not declare login/registration probe history complete.
NETWORK_HISTORY_COMPLETE=false

# Persistent local state, including automatic-group configuration and audit logs.
DATA_DIR=./data
# Optional saved connection file; empty uses DATA_DIR/connections.json.
SITEADMIN_CONFIG_FILE=

TIMEZONE=Asia/Shanghai
QUOTA_PER_UNIT=500000

# Publish on loopback by default. Keep this binding unless a reverse proxy needs access.
BIND_ADDRESS=127.0.0.1
HOST_PORT=18080
